# --- Database (Supabase PostgreSQL) ---
# Pooled connection (app runtime)
DATABASE_URL=
# Direct connection (migrations)
DIRECT_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM pool (free models) ---
# Comma-separated provider:model entries, tried in order. Providers: groq, openrouter,
# cerebras, gemini, mistral, anthropic. Entries without a key are skipped.
LLM_MODELS=groq:openai/gpt-oss-120b,openrouter:google/gemma-4-31b-it:free,openrouter:qwen/qwen3.8-27b:free
# failover = start at top every time; rotate = round-robin to spread rate limits
LLM_STRATEGY=failover
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
MISTRAL_API_KEY=         # https://console.mistral.ai
OPENAI_API_KEY=          # paid per use: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=       # optional
CLAUDE_MODEL=            # optional, used for anthropic default

# --- Telegram (https://my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 32 random bytes, hex or base64:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# --- Redis (BullMQ) ---
REDIS_URL=

# --- Worker (npm run worker) ---
# Parallel conversations being sent at once (Telegram pacing is enforced per account regardless)
WORKER_SEND_CONCURRENCY=3
# Parallel AI generations; keep at 1 on free-tier models
WORKER_GENERATION_CONCURRENCY=1
# Browser used to render JavaScript sites for LakiPH Knowledge (msedge, chrome); default tries both
BROWSER_CHANNEL=
# TESTING ONLY: "true" = nothing is ever sent to Telegram (messages are marked sent). Never leave on.
SIMULATION_DRY_RUN=


# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database pool ---
# Connections each process (dashboard, worker, scripts) may hold. Keep small: Supabase's free pooler
# only has about 15 server connections shared by everything. Raise on a paid plan.
DB_POOL_MAX=4

# --- Error monitoring (optional) ---
# Set a Sentry DSN and `npm i @sentry/node` to report errors. Message text and credentials are never sent.
SENTRY_DSN=

# --- Browser tests (npm run test:e2e) ---
# Browser used by Playwright; Microsoft Edge is already on Windows.
E2E_BROWSER_CHANNEL=

# Comma-separated emails allowed into the dashboard. Set this before hosting (see README).
ADMIN_EMAILS=
